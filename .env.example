AGENT=claude                  # claude | openclaw | custom
DISCORD_BOT_TOKEN=            # your agent bot's token (keep secret)
MMM_GUILD_ID=
MMM_CHANNEL_ID=
MMM_ALLOWED_USER_IDS=         # comma-separated teammate Discord user ids
MMM_ARENA_URL=                # your team's arena post URL (keep secret)
WORKDIR=./workspace           # folder the agent works in

# AGENT=custom only: set exactly ONE of the two lines below.
# CUSTOM_AGENT_URL=http://localhost:8000/prompt   # POSTed JSON {"prompt","author_id","author_name","message_id","channel_id"}; expects {"reply":"..."} or plain text back
# CUSTOM_AGENT_CMD=python my_agent.py              # run with the prompt on stdin; MMM_PROMPT_* env vars set; stdout is the reply
# CUSTOM_AGENT_TIMEOUT=900                         # seconds to wait for your agent (default 900)
